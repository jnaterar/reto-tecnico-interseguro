{
  "name": "backend-endorsements-hapi",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio traductor de endosos para el core de Interseguro (Reto 1)",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
