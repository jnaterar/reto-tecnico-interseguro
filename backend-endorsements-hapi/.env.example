# HTTP
PORT=8082
HOST=0.0.0.0

# Base de datos (PostgreSQL / TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=interseguro
DB_PASSWORD=interseguro
DB_NAME=endorsements
DB_SYNCHRONIZE=true
DB_LOGGING=false
# TLS hacia Postgres gestionado (Render, Cloud SQL por IP pública). En local: false.
DB_SSL=false

# Seguridad (JWT HS256)
JWT_SECRET=dev-secret-change-me-please
JWT_TTL_SECONDS=3600
ENABLE_DEMO_TOKEN=true

# CORS (separadas por coma o * para desarrollo)
CORS_ORIGINS=*
