# Entorno de ejecución: development | test | production.
# La imagen de producción fija NODE_ENV=production (Cloud Run inyecta el resto).
NODE_ENV=development

# HTTP
# PORT: Cloud Run lo inyecta en runtime; en local/Docker se usa 8082.
PORT=8082
HOST=0.0.0.0

# Base de datos (PostgreSQL / TypeORM)
# DB_HOST, DB_USER, DB_PASSWORD y DB_NAME son OBLIGATORIAS: no existen
# defaults a localhost ni a nombres de docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_USER=interseguro
DB_PASSWORD=interseguro
DB_NAME=endorsements
# Solo para local/demo: en producción se usan migraciones versionadas.
DB_SYNCHRONIZE=true
DB_LOGGING=false
# TLS hacia Postgres gestionado (Cloud SQL por IP pública, Render). En local: false.
DB_SSL=false
# Verificación de la cadena del certificado. Se deja true SIEMPRE que la CA del
# servidor sea pública (Neon usa Let's Encrypt). Poner false solo contra un
# certificado self-signed: desactivarla convierte TLS en cifrado sin autenticar
# al servidor y permite un man-in-the-middle.
DB_SSL_REJECT_UNAUTHORIZED=true

# Seguridad (JWT HS256)
# OBLIGATORIA y de al menos 16 caracteres. En Cloud Run la inyecta
# deploy-gcp.sh como variable de entorno del servicio; no se versiona ningún
# valor real.
JWT_SECRET=dev-secret-change-me-please
# Vida del token: 3600 s (1 hora) por default en todos los entornos. Una sesión
# de evaluación cabe de sobra y el riesgo lo acota el scope, no el reloj.
JWT_TTL_SECONDS=3600
# Emisor de tokens de demo. Se deja true para que el jurado pueda autenticarse,
# pero el token queda acotado al scope endorse:translate (cualquier otro scope
# devuelve 400) y la ruta /v1/endorse/translate exige ese scope (403 si no).
ENABLE_DEMO_TOKEN=true

# CORS: lista de orígenes separados por coma. Se compara por origen exacto y se
# refleja en Access-Control-Allow-Origin; nunca se responde '*'.
# En producción es obligatorio fijarla (buildServer falla si contiene '*'):
# ./deploy-gcp.sh update-cors la rellena con la URL del frontend desplegado.
# Vacía en development = ['http://localhost:8080', 'http://localhost:5173'].
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
