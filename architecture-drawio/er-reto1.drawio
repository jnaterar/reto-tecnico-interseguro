        <mxCell id="subtitulo" value="Cinco tablas relacionales. La etiqueta, el orden y el valor de cada campo del endoso viven en template_fields y template_events: agregar un producto o tipo de endoso es un INSERT." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748b;" vertex="1" parent="1">
