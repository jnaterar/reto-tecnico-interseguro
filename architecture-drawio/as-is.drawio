<mxfile host="app.diagrams.net" agent="Roo Code" version="24.7.17" type="device">
  <diagram id="as-is-disbursement" name="AS-IS — Desembolso sincrónico">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="860" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AS-IS — Desembolso sincrónico de préstamos: el fallo está en la frontera Proxy INARI ↔ Backend" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1020" height="40" as="geometry" />
        </mxCell>

        <mxCell id="client" value="Cliente / Zona Segura (SPA)&#10;Espera la confirmación en pantalla" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="Backend Node (orquestador)&#10;Invoca INARI y espera la respuesta síncrona" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="230" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="Proxy INARI&#10;Timeout del proxy = T_proxy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="380" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="admwr" value="Servidor admwr (VMware INARI)&#10;T_admwr mayor que T_proxy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="530" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="core" value="Core transaccional / AS400&#10;Ejecuta el desembolso" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="680" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Base de datos de solicitudes&#10;SIN clave única de idempotencia" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontSize=12;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="380" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="danger" value="ZONA DE PELIGRO&#10;La operación puede quedar ejecutada pero no confirmada. Subir el timeout reduce la probabilidad; no elimina el fallo." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;fontStyle=1;fontColor=#7a1f1f;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="540" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="rootcause" value="Problema raíz: el proxy devuelve 502 mientras admwr sigue procesando; el cliente reintenta y el desembolso se duplica." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#7a1f1f;" vertex="1" parent="1">
