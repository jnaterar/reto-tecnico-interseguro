# Bases relativas por defecto: las resuelve el proxy de Vite (dev) o nginx (Docker).
# Solo cámbialas si el frontend se sirve desde otro dominio que los backends.
VITE_ENDORSE_API_BASE=/endorse-api
VITE_ROUTES_API_BASE=/routes-api

# Destinos del proxy de Vite en desarrollo (no afectan al build de producción).
ENDORSE_API_PROXY=http://localhost:8082
ROUTES_API_PROXY=http://localhost:8081
