# URLs de los backends expuestas al frontend.
#
# Son variables BUILD-TIME de Vite: se incrustan en el bundle al ejecutar
# `npm run build` / `docker build`. Si cambian, hay que reconstruir la imagen.
#
# Local/Docker: rutas relativas resueltas por el proxy de Vite o nginx
# (/endorse-api y /routes-api, sin barra final).
# Cloud: URLs absolutas por servicio (el navegador aplicará CORS, que cada
# backend configura vía CORS_ORIGIN / CORS_ORIGINS).
VITE_API_ENDORSEMENTS_URL=/endorse-api
VITE_API_ROUTES_URL=/routes-api

# Destinos del proxy de Vite en desarrollo (no afectan al build de producción).
ENDORSE_API_PROXY=http://localhost:8082
ROUTES_API_PROXY=http://localhost:8081
