# Plantilla de nginx procesada por el entrypoint oficial de la imagen
# (docker-entrypoint.d/20-envsubst-on-templates.sh).
#
# `${PORT}` lo inyecta Cloud Run (o el ENV PORT=8080 de la imagen en local).
# Los `$uri`, `$host`, etc. de nginx NO se sustituyen porque no son variables
# de entorno: el script solo reemplaza nombres presentes en el entorno.
#
# Los bloques /endorse-api/ y /routes-api/ usan los nombres DNS de
# docker-compose. En Cloud Run esos nombres no existen: allí el frontend se
# construye con URLs absolutas y no llama a estas rutas. Se mantienen para que
# `docker compose up --build` siga funcionando sin CORS en el navegador.
server {
    listen ${PORT};
    server_name _;

    # No anunciar la versión de nginx en errores ni en la cabecera Server.
    server_tokens off;

    # Endurecimiento de la SPA. `always` hace que también se apliquen a 4xx/5xx.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # CSP: el bundle de Vite carga su JS desde /assets (script-src 'self') y no
    # usa HTML inyectado ni scripts inline, así que no hace falta 'unsafe-inline'
    # para scripts. En estilos sí se permite porque React puede aplicar atributos
    # `style`. `connect-src 'self' https:` cubre los dos modos de la app: rutas
    # relativas tras este nginx (compose) y llamadas absolutas a los backends
    # HTTPS de Cloud Run, sin abrir la puerta a orígenes http.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # HSTS: Cloud Run sirve HTTPS en el borde. Sin includeSubDomains ni preload
    # para no condicionar un cambio de host de la demo.
    add_header Strict-Transport-Security "max-age=31536000" always;

    root /usr/share/nginx/html;
    index index.html;

    # Resolución perezosa de los upstreams de compose. Si se usara
    # `proxy_pass http://endorsements:8082` directamente, nginx resolvería el
    # nombre AL ARRANCAR y en Cloud Run (donde ese DNS no existe) el contenedor
    # moriría con "host not found in upstream". Con variables + resolver, la
    # resolución ocurre solo si alguien llama a la ruta; el arranque y el
    # /healthz funcionan igual en local y en la nube.
    # 127.0.0.11 es el DNS embebido de Docker (solo aplica en compose).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Healthcheck del propio contenedor.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # /endorse-api/v1/... -> http://endorsements:8082/v1/... (solo compose)
    location /endorse-api/ {
        set $endorse_upstream http://endorsements:8082;
        rewrite ^/endorse-api/(.*)$ /$1 break;
        proxy_pass $endorse_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /routes-api/v1/... -> http://routes:8081/v1/... (solo compose)
    location /routes-api/ {
        set $routes_upstream http://routes:8081;
        rewrite ^/routes-api/(.*)$ /$1 break;
        proxy_pass $routes_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: cualquier ruta desconocida vuelve a index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
